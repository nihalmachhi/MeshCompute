MESH_COMPUTE_DATABASE_URL=postgresql+psycopg://meshcompute:meshcompute@localhost:5433/meshcompute
MESH_COMPUTE_ADMIN_TOKEN=replace-with-a-long-random-value
MESH_COMPUTE_API_HOST=0.0.0.0
MESH_COMPUTE_API_PORT=8000
MESH_COMPUTE_MAX_PENDING_TASKS=10000
MESH_COMPUTE_LEASE_TTL_SECONDS=30
MESH_COMPUTE_DATA_DIR=/data
MESH_COMPUTE_OUTPUT_DIR=/output
MESH_COMPUTE_WORKER_STALE_SECONDS=45
MESH_COMPUTE_REAPER_INTERVAL_SECONDS=5
MESH_COMPUTE_LOG_LEVEL=INFO
MESH_COMPUTE_WORKER_OFFLINE_SECONDS=300
MESH_COMPUTE_WORKER_RETENTION_SECONDS=86400
MESH_COMPUTE_RESULT_RETENTION_SECONDS=604800
MESH_COMPUTE_MAX_RESULT_BYTES=10000000
MESH_COMPUTE_PRIORITY_AGING_SECONDS=30
MESH_COMPUTE_RETRY_BASE_SECONDS=1
MESH_COMPUTE_RETRY_MAX_SECONDS=60
MESH_COMPUTE_RETRY_JITTER_FRACTION=0.2
